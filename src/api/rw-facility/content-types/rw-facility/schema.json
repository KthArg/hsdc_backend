{
  "kind": "collectionType",
  "collectionName": "rw_facilities",
  "info": {
    "singularName": "rw-facility",
    "pluralName": "rw-facilities",
    "displayName": "Instalaciones",
    "description": "Instalaciones de la finca (rework)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
